# Neon or another serverless Postgres connection string.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# At least 20 random characters. Used only on the server.
TRADING_ADMIN_TOKEN=replace-with-a-long-random-passcode

# Optional alert receiver for watcher failure/recovery notifications.
TRADING_ALERT_WEBHOOK_URL=https://example.com/private-alert-webhook
TRADING_ALERT_WEBHOOK_TOKEN=replace-with-webhook-bearer-token
