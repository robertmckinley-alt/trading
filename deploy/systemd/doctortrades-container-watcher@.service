[Unit]
Description=DoctorTrades paper watcher (%i) in OpenClaw container
Requires=docker.service doctortrades-container-feed.service
After=docker.service network-online.target doctortrades-container-feed.service
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=/usr/bin/docker start openclaw-anwx-openclaw-1
ExecStart=/usr/bin/docker exec -w /data/.openclaw/workspace/lucid-nq-paper-trader openclaw-anwx-openclaw-1 /bin/bash -lc "set -a; . ./.env.local; set +a; if [ '%i' = 'live-9am-sweep' ]; then log_file=runtime/lucid-nq-paper-trader-watch.log; else log_file=runtime/%i-watch.log; fi; exec node paper-trader.cjs watch-live --provider=databento-live --interval=60000 --strategy=%i >> \"$log_file\" 2>&1"
ExecStartPost=/usr/bin/docker exec -w /data/.openclaw/workspace/lucid-nq-paper-trader openclaw-anwx-openclaw-1 /bin/bash -lc "if [ '%i' = 'live-9am-sweep' ]; then pid_file=runtime/lucid-nq-paper-trader-watch.pid; else pid_file=runtime/%i-watch.pid; fi; pgrep -n -f '^node paper-trader.cjs watch-live.*--strategy=%i' > \"$pid_file\""
ExecStop=/usr/bin/docker exec openclaw-anwx-openclaw-1 /bin/bash -lc "pkill -TERM -f '^node paper-trader.cjs watch-live.*--strategy=%i' || true"
ExecStopPost=/usr/bin/docker exec -w /data/.openclaw/workspace/lucid-nq-paper-trader openclaw-anwx-openclaw-1 /bin/bash -lc "if [ '%i' = 'live-9am-sweep' ]; then pid_file=runtime/lucid-nq-paper-trader-watch.pid; else pid_file=runtime/%i-watch.pid; fi; rm -f \"$pid_file\""
Restart=always
RestartSec=10
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
