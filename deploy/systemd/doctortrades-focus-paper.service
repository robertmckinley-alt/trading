[Unit]
Description=Profit Focus independent $1000 risk paper trial
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=simple
ExecStartPre=/usr/bin/docker start openclaw-anwx-openclaw-1
ExecStart=/usr/bin/docker exec -w /data/.openclaw/workspace/lucid-nq-paper-trader openclaw-anwx-openclaw-1 node scripts/focus-paper-worker.cjs --watch
ExecStop=/usr/bin/docker exec openclaw-anwx-openclaw-1 pkill -TERM -f "^node scripts/focus-paper-worker[.]cjs --watch$"
Restart=always
RestartSec=10
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
