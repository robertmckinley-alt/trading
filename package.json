{
  "name": "lucid-nq-paper-trader-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "test": "node --test",
    "start": "next start",
    "trader:plan": "node paper-trader.cjs live-plan",
    "trader:watch": "node paper-trader.cjs watch-live",
    "trader:watch:mock": "node paper-trader.cjs watch-live --provider=mock",
    "trader:watch:start": "bash scripts/start-live-watcher.sh",
    "trader:watch:stop": "bash scripts/stop-live-watcher.sh",
    "trader:watch:status": "bash scripts/status-live-watcher.sh",
    "trader:status:server": "node scripts/live-status-server.cjs"
  },
  "dependencies": {
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.3.3"
  }
}
